<UserControl x:Class="Everything.App.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Everything.App">
    <DockPanel Margin="4,14,4,8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Click="OnRefresh" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Yenile" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="DisksInfo" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DisksList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:DiskInfo}">
                        <Border Style="{StaticResource Card}" Width="380" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="20" Margin="0,0,12,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding HasMediaType, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding MediaType}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding HasBusType, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding BusType}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource BarTrack}" Width="346" Height="6" CornerRadius="3" Margin="0,16,0,8">
                                    <Border CornerRadius="3" HorizontalAlignment="Left"
                                            Background="{Binding UsedPercent, Converter={StaticResource UsageBrush}}"
                                            Width="{Binding UsedPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=346}" />
                                </Border>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText}" Style="{StaticResource Caption}" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding FreeSpace, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                        <Run Text="boş /" />
                                        <Run Text="{Binding TotalSize, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>

                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,0,0,5" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Sağlık durumu" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Health}" />
                                    <TextBlock Grid.Row="1" Text="Kullanılan" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsedSpace, Converter={StaticResource Bytes}}" />
                                    <TextBlock Grid.Row="2" Text="Dosya sistemi" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileSystem}" />
                                    <TextBlock Grid.Row="3" Text="Fiziksel disk" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PhysicalSizeText}" />
                                    <TextBlock Grid.Row="4" Text="Disk seri no" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SerialText}" />
                                    <TextBlock Grid.Row="5" Text="Birim seri no" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VolumeSerialText}" />
                                </Grid>

                                <!-- SMART -->
                                <ItemsControl ItemsSource="{Binding HealthRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding HealthStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{Binding HasHealthStatus, Converter={StaticResource BoolToVisibility}}" />

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Click="OnAnalyze" Tag="{Binding RootPath}" Margin="0,0,8,0" Padding="10,5" Style="{DynamicResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEB05;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Alan analizi" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnBenchmark" Tag="{Binding RootPath}" Margin="0,0,8,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Hız testi" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnOpen" Tag="{Binding RootPath}" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Aç" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
