<Window x:Class="Everything.App.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hızlı arama" Width="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="10">
        <StackPanel>
            <Grid>
                <TextBox x:Name="SearchBox" FontSize="16" Padding="38,9,10,9" VerticalContentAlignment="Center" TextChanged="OnTextChanged" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="16" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="Placeholder" Text="Ara…" FontSize="16" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Secondary}" />
            </Grid>

            <ListBox x:Name="Results" Margin="0,8,0,0" MaxHeight="430" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                     MouseDoubleClick="OnResultDoubleClick" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Footer" Margin="4,8,4,0" Style="{StaticResource Caption}"
                       Text="Enter aç  ·  Ctrl+Enter konumunu aç  ·  Ctrl+C yolu kopyala  ·  Esc kapat" />
        </StackPanel>
    </Border>
</Window>
