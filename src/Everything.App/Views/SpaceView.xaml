<UserControl x:Class="Everything.App.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Everything.App"
             xmlns:views="clr-namespace:Everything.App.Views">
    <DockPanel Margin="4,14,4,8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox x:Name="VolumeCombo" Width="110" Margin="0,0,8,0" SelectionChanged="OnVolumeChanged" ToolTip="Sürücü" />
            <Button Click="OnRefresh" Margin="0,0,8,0" Padding="10,6" ToolTip="Görünümü güncel indeksle yenile">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Yenile" />
                </StackPanel>
            </Button>
            <Button Click="OnRescan" Margin="0,0,12,0" Padding="10,6" ToolTip="Sürücüyü baştan tara">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Yeniden tara" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="SpaceInfo" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="6*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Klasör ağacı -->
            <Border Style="{StaticResource Card}" Padding="4">
                <TreeView x:Name="SpaceTree" SelectedItemChanged="OnTreeSelectionChanged"
                          BorderThickness="0" Background="Transparent"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="OnTreeDoubleClick">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type app:FolderNode}" ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" />
                                <Border Grid.Column="1" Style="{StaticResource BarTrack}" Width="64" Height="4">
                                    <Border Style="{StaticResource BarFill}"
                                            Width="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=64}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource RightCell}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding PercentText}" Margin="0,0,12,0" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding FileCountText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                                </TextBlock>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Sağ panel -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="SelectionTitle" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                <TabControl x:Name="DetailTabs" BorderThickness="0" Background="Transparent" SelectionChanged="OnDetailTabChanged">
                    <TabItem Header="Harita" x:Name="MapTab">
                        <DockPanel Margin="0,8,0,0">
                            <WrapPanel x:Name="Legend" DockPanel.Dock="Top" Margin="0,0,0,8" />
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button x:Name="UpButton" DockPanel.Dock="Right" Click="OnTreemapUp" Padding="10,4" ToolTip="Üst klasöre çık">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Yukarı" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="HoverText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="Bir kutunun üzerine gelin; klasöre girmek için çift tıklayın." />
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="2">
                                <views:TreemapControl x:Name="Treemap" />
                            </Border>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Kategoriler">
                        <ListView x:Name="CategoryList" Margin="0,8,0,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Kategori" Width="150" DisplayMemberBinding="{Binding Key}" />
                                    <GridViewColumn Header="Boyut" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Pay" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource BarTrack}" Width="70" Height="4" Margin="0,0,8,0">
                                                        <Border Style="{StaticResource BarFill}"
                                                                Width="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=70}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dosya" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Secondary}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="Dosya türleri">
                        <ListView x:Name="TypeList" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="OnTypeDoubleClick"
                                  ToolTip="Çift tıklayarak bu türdeki dosyaları ara">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Uzantı" Width="100" DisplayMemberBinding="{Binding Key}" />
                                    <GridViewColumn Header="Kategori" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Secondary}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Boyut" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Pay" Width="70" DisplayMemberBinding="{Binding PercentText}" />
                                    <GridViewColumn Header="Dosya" Width="80" DisplayMemberBinding="{Binding CountText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="En büyük dosyalar">
                        <ListView x:Name="LargestList" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True"
                                  MouseDoubleClick="OnLargestDoubleClick" SelectionMode="Extended">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Ad" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Boyut" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Konum" Width="320">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="Büyüyenler" x:Name="GrowthTab">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <ComboBox x:Name="GrowthPeriod" Width="140" Margin="0,0,8,0" SelectedIndex="1" SelectionChanged="OnGrowthOptionChanged">
                                    <ComboBoxItem Content="Son 24 saat" Tag="1" />
                                    <ComboBoxItem Content="Son 7 gün" Tag="7" />
                                    <ComboBoxItem Content="Son 30 gün" Tag="30" />
                                </ComboBox>
                                <ComboBox x:Name="GrowthDirection" Width="120" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="OnGrowthOptionChanged">
                                    <ComboBoxItem Content="Büyüyenler" />
                                    <ComboBoxItem Content="Küçülenler" />
                                </ComboBox>
                                <TextBlock x:Name="GrowthInfo" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <ListView x:Name="GrowthList" MouseDoubleClick="OnGrowthDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Klasör" Width="300">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Değişim" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DeltaText}" Style="{StaticResource RightCell}" FontWeight="SemiBold" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Önce" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OldText}" Style="{StaticResource RightCell}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Şimdi" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding NewText}" Style="{StaticResource RightCell}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
