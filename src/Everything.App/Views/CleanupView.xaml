<UserControl x:Class="Everything.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4,14,4,8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Click="OnDiskCleanup" Padding="10,6" ToolTip="Windows.old, sistem dosyaları vb. için Windows'un kendi aracı">
                <TextBlock Text="Windows Disk Temizleme…" />
            </Button>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                       Text="Güvenle silinebilecek dosyalar. Kullanımdaki dosyalar atlanır; belgelerinize dokunulmaz." />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="CleanButton" DockPanel.Dock="Right" Click="OnClean" Padding="14,6" Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="CleanButtonText" Text="Seçilenleri temizle" />
                </StackPanel>
            </Button>
            <Button x:Name="ScanButton" DockPanel.Dock="Right" Click="OnScan" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Yeniden hesapla" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TargetList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanClean}"
                                          VerticalAlignment="Center" Margin="0,0,4,0" Click="OnTargetToggled"
                                          Visibility="{Binding CanClean, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Margin="4,0,14,0" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" MinWidth="80" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Button Content="İncele" Margin="12,0,0,0" Padding="10,4" Click="OnReview" Tag="{Binding}"
                                            Visibility="{Binding IsReviewOnly, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
