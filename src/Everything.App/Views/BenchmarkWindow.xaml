<Window x:Class="Everything.App.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk hız testi" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Closing="OnClosing">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
                   Text="CrystalDiskMark'a benzer ölçüm: sıralı (SEQ) ve rastgele 4K (RND) okuma/yazma. Diske geçici bir test dosyası yazılır, test bitince silinir." />

        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Test dosyası" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="SizeCombo" Width="110" SelectedIndex="1">
                <ComboBoxItem Content="256 MB" Tag="268435456" />
                <ComboBoxItem Content="1 GB" Tag="1073741824" />
                <ComboBoxItem Content="4 GB" Tag="4294967296" />
            </ComboBox>
            <Button x:Name="StartButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Başlat" Padding="16,6"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnStart" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid x:Name="ResultGrid" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Text="Okuma (MB/s)" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Yazma (MB/s)" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,6" Maximum="1" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
    </StackPanel>
</Window>
