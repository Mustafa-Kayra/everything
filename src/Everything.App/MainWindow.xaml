<Window x:Class="Everything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Everything.App"
        Title="Everything"
        Width="1180" Height="760" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing">

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RescanCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.FocusSearchCommand}" Executed="OnFocusSearch" />
        <CommandBinding Command="{x:Static local:MainWindow.RescanCommand}" Executed="OnRescanAll" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Arama sonucu / dosya listeleri için ortak sağ tık menüsü -->
        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="Aç" Click="OnMenuOpen" FontWeight="SemiBold">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Dosya konumunu aç" Click="OnMenuShowInExplorer">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Tam yolu kopyala" Click="OnMenuCopyPath">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Geri Dönüşüm Kutusu'na taşı…" Click="OnMenuDelete">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Sekme başlığı: ikon + metin -->
        <DataTemplate x:Key="TabHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Durum çubuğu -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Başlatılıyor…" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12,8,12,0" SelectionChanged="OnTabChanged" BorderThickness="0" Background="Transparent">

            <!-- ============ ARA ============ -->
            <TabItem Header="Ara" Tag="&#xE721;" HeaderTemplate="{StaticResource TabHeader}" x:Name="SearchTab">
                <Grid Margin="4,14,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox x:Name="SearchBox" FontSize="14" Padding="34,7,10,7" VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Dosya veya klasör ara…   örn. rapor ext:pdf · *.mp4 size:>1gb · folder:proje"
                                   IsHitTestVisible="False" Margin="35,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Secondary}" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="2,8,2,8">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}">
                            <Hyperlink Click="OnShowSearchHelp">Arama ipuçları</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="SearchInfo" Style="{StaticResource Caption}" />
                    </DockPanel>

                    <ListView x:Name="ResultsList" Grid.Row="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              SelectionMode="Extended"
                              ContextMenu="{StaticResource ItemMenu}"
                              MouseDoubleClick="OnResultDoubleClick"
                              KeyDown="OnResultKeyDown"
                              GridViewColumnHeader.Click="OnResultHeaderClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Konum" Width="460">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Boyut" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Değiştirilme" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Secondary}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ============ DİSKLER ============ -->
            <TabItem Header="Diskler" Tag="&#xEDA2;" HeaderTemplate="{StaticResource TabHeader}" x:Name="DisksTab">
                <DockPanel Margin="4,14,4,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Click="OnRefreshDisks" ToolTip="Yenile" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Yenile" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DisksInfo" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DisksList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DiskInfo}">
                                    <Border Style="{StaticResource Card}" Width="380" Margin="0,0,12,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="20" Margin="0,0,12,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding HasMediaType, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding MediaType}" FontSize="11" />
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding HasBusType, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding BusType}" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Doluluk -->
                                            <Border Style="{StaticResource BarTrack}" Width="346" Height="6" CornerRadius="3" Margin="0,16,0,8">
                                                <Border CornerRadius="3" HorizontalAlignment="Left"
                                                        Background="{Binding UsedPercent, Converter={StaticResource UsageBrush}}"
                                                        Width="{Binding UsedPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=346}" />
                                            </Border>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText}" Style="{StaticResource Caption}" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding FreeSpace, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                                    <Run Text="boş /" />
                                                    <Run Text="{Binding TotalSize, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>

                                            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="0,0,0,5" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Sağlık" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Health}" />
                                                <TextBlock Grid.Row="1" Text="Kullanılan" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsedSpace, Converter={StaticResource Bytes}}" />
                                                <TextBlock Grid.Row="2" Text="Dosya sistemi" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileSystem}" />
                                                <TextBlock Grid.Row="3" Text="Sürücü türü" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriveType}" />
                                                <TextBlock Grid.Row="4" Text="Fiziksel disk" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PhysicalSizeText}" />
                                                <TextBlock Grid.Row="5" Text="Disk seri no" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SerialText}" />
                                                <TextBlock Grid.Row="6" Text="Birim seri no" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding VolumeSerialText}" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Click="OnAnalyzeDisk" Tag="{Binding RootPath}" Margin="0,0,8,0" Padding="10,5"
                                                        Style="{DynamicResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEB05;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="Alan analizi" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="OnOpenDisk" Tag="{Binding RootPath}" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="Aç" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ ALAN ANALİZİ ============ -->
            <TabItem Header="Alan Analizi" Tag="&#xEB05;" HeaderTemplate="{StaticResource TabHeader}" x:Name="SpaceTab">
                <DockPanel Margin="4,14,4,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <ComboBox x:Name="VolumeCombo" Width="110" Margin="0,0,8,0" SelectionChanged="OnVolumeChanged" ToolTip="Sürücü" />
                        <Button Click="OnRefreshSpace" Margin="0,0,8,0" Padding="10,6" ToolTip="Görünümü güncel indeksle yenile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Yenile" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRescanVolume" Margin="0,0,12,0" Padding="10,6" ToolTip="Sürücüyü baştan tara">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Yeniden tara" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SpaceInfo" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" MinWidth="300" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="5*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- Klasör ağacı -->
                        <Border Style="{StaticResource Card}" Padding="4">
                            <TreeView x:Name="SpaceTree" SelectedItemChanged="OnTreeSelectionChanged"
                                      BorderThickness="0" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      MouseDoubleClick="OnTreeDoubleClick" ContextMenu="{StaticResource ItemMenu}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,0,10,0" />
                                            <Border Grid.Column="1" Style="{StaticResource BarTrack}" Width="64" Height="4">
                                                <Border Style="{StaticResource BarFill}"
                                                        Width="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=64}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource RightCell}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding FileCountText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                                            </TextBlock>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- Sağ panel -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" x:Name="SelectionTitle" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                            <TabControl BorderThickness="0" Background="Transparent">
                                <TabItem Header="Kategoriler">
                                    <ListView x:Name="CategoryList" Margin="0,8,0,0">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Kategori" Width="150" DisplayMemberBinding="{Binding Key}" />
                                                <GridViewColumn Header="Boyut" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Pay" Width="140">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Style="{StaticResource BarTrack}" Width="70" Height="4" Margin="0,0,8,0">
                                                                    <Border Style="{StaticResource BarFill}"
                                                                            Width="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=70}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Dosya" Width="80">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Secondary}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </TabItem>
                                <TabItem Header="Dosya türleri">
                                    <ListView x:Name="TypeList" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="OnTypeDoubleClick"
                                              ToolTip="Çift tıklayarak bu türdeki dosyaları ara">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Uzantı" Width="100" DisplayMemberBinding="{Binding Key}" />
                                                <GridViewColumn Header="Kategori" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Secondary}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Boyut" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Pay" Width="70" DisplayMemberBinding="{Binding PercentText}" />
                                                <GridViewColumn Header="Dosya" Width="80" DisplayMemberBinding="{Binding CountText}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </TabItem>
                                <TabItem Header="En büyük dosyalar">
                                    <ListView x:Name="LargestList" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True"
                                              MouseDoubleClick="OnResultDoubleClick" KeyDown="OnResultKeyDown"
                                              ContextMenu="{StaticResource ItemMenu}" SelectionMode="Extended">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Ad" Width="220" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Boyut" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Konum" Width="320">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
