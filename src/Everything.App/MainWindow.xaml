<Window x:Class="Everything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Everything.App"
        xmlns:views="clr-namespace:Everything.App.Views"
        Title="Everything"
        Width="1200" Height="780" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico"
        Loaded="OnLoaded" Closing="OnClosing">

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RescanCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.FocusSearchCommand}" Executed="OnFocusSearch" />
        <CommandBinding Command="{x:Static local:MainWindow.RescanCommand}" Executed="OnRescanAll" />
    </Window.CommandBindings>

    <Window.Resources>
        <DataTemplate x:Key="TabHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Güncelleme bildirimi -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,10,12,0" Padding="14,8" CornerRadius="6"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sonra" Click="OnDismissUpdate" Padding="10,4" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Güncelle" Click="OnShowUpdate" Padding="12,4" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Durum çubuğu -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
                <TextBlock x:Name="ModeBadge" DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Başlatılıyor…" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12,8,12,0" SelectionChanged="OnTabChanged" BorderThickness="0" Background="Transparent">
            <TabItem Header="Ara" Tag="&#xE721;" HeaderTemplate="{StaticResource TabHeader}" x:Name="SearchTab">
                <views:SearchView x:Name="SearchView" />
            </TabItem>
            <TabItem Header="Diskler" Tag="&#xEDA2;" HeaderTemplate="{StaticResource TabHeader}" x:Name="DisksTab">
                <views:DisksView x:Name="DisksView" />
            </TabItem>
            <TabItem Header="Alan Analizi" Tag="&#xEB05;" HeaderTemplate="{StaticResource TabHeader}" x:Name="SpaceTab">
                <views:SpaceView x:Name="SpaceView" />
            </TabItem>
            <TabItem Header="Kopyalar" Tag="&#xE8C8;" HeaderTemplate="{StaticResource TabHeader}" x:Name="DuplicatesTab">
                <views:DuplicatesView x:Name="DuplicatesView" />
            </TabItem>
            <TabItem Header="Temizlik" Tag="&#xEA99;" HeaderTemplate="{StaticResource TabHeader}" x:Name="CleanupTab">
                <views:CleanupView x:Name="CleanupView" />
            </TabItem>
            <TabItem Header="Ayarlar" Tag="&#xE713;" HeaderTemplate="{StaticResource TabHeader}" x:Name="SettingsTab">
                <views:SettingsView x:Name="SettingsView" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
